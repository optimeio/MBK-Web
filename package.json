{
  "name": "mbk-courses",
  "version": "1.0.0",
  "description": "MBK Courses MERN Application",
  "scripts": {
    "postinstall": "cd frontend && npm install && cd ../backend && npm install",
    "build-all": "cd frontend && npm run build",
    "start": "cd backend && node server.js",
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:backend\"",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:backend": "cd backend && node server.js"
  },
  "author": "MBK Technology",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
